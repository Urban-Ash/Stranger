# ===== 基础服务配置 =====
# APP_NAME：应用显示名称（用于页面展示与日志）
APP_NAME=Stranger Database Query System
# APP_VERSION：应用版本号（用于页脚与接口返回）
APP_VERSION=1.0.0

# AUTH_ENABLED：是否启用身份认证（true/false）
AUTH_ENABLED=true
# AUTH_USERNAME：认证用户名（启用认证时必需）
AUTH_USERNAME=admin
# AUTH_PASSWORD：认证密码（启用认证时必需，生产环境请更改）
AUTH_PASSWORD=admin
# AUTH_PASSWORD_HASH：预计算的密码哈希（可选，优先级高于 AUTH_PASSWORD）
AUTH_PASSWORD_HASH=

# Flask 基本参数
# FLASK_APP：WSGI 入口（生产部署 gunicorn 使用）
FLASK_APP=app.app:app
# FLASK_ENV：运行环境（development/production/testing）
FLASK_ENV=development
# FLASK_HOST：服务监听地址（0.0.0.0 表示所有接口）
FLASK_HOST=0.0.0.0
# FLASK_PORT：服务监听端口（开发默认 8080，生产默认 5082）
FLASK_PORT=5082
# FLASK_DEBUG：是否开启调试模式（生产环境必须设为 False）
FLASK_DEBUG=False

# 安全与跨域
# SECRET_KEY：会话/CSRF 加密密钥（生产环境必须更改为随机字符串）
SECRET_KEY=change-me-in-production
# CSRF_ENABLED：是否启用 CSRF 保护（true/false）
CSRF_ENABLED=True
# CORS_ORIGINS：允许的跨域来源，逗号分隔或 * 表示全部（生产环境建议限制具体域名）
CORS_ORIGINS=*

# ===== 日志与限速 =====
# LOG_LEVEL：日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
LOG_LEVEL=INFO
# LOG_FILE：日志文件路径（相对或绝对路径）
LOG_FILE=app.log
# LOG_FORMAT：日志格式模板（Python logging 格式）
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(funcName)s:%(lineno)d - %(message)s

# 全局速率限制
# RATE_LIMIT：全局速率限制规则（如 60 per minute, 100 per hour）
RATE_LIMIT=60 per minute
# 兼容项（可选）：
# API_RATE_LIMIT：兼容项，映射为 RATE_LIMIT（可留空或与 RATE_LIMIT 相同）
API_RATE_LIMIT=100 per hour

# ===== 结果与缓存 =====
# MAX_RESULTS：单次返回的默认最大结果数（防止大量数据返回）
MAX_RESULTS=50
# MAX_QUERY_RESULTS：兼容项，等价于 MAX_RESULTS
MAX_QUERY_RESULTS=50
# CACHE_TIMEOUT：默认缓存过期时间（秒，0 表示不缓存）
CACHE_TIMEOUT=300

# ===== 外部服务（AI，可选） =====
# DEEPSEEK_API_KEY：DeepSeek API 密钥（用于 AI 置信度评估功能）
DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL：DeepSeek API 地址（默认官方地址）
DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL：使用的模型名称（如 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# ===== 数据库（PostgreSQL） =====
# PG_HOST：PostgreSQL 主机地址（localhost 或 IP 地址）
PG_HOST=localhost
# PG_PORT：PostgreSQL 端口（默认 5432）
PG_PORT=5432
# PG_DATABASE：数据库名称（需要预先创建）
PG_DATABASE=stranger
# PG_USER：数据库用户名（需要有读写权限）
PG_USER=postgres
# PG_PASSWORD：数据库密码（生产环境必须更改）
PG_PASSWORD=change-me

# 来源详情接口语句超时（毫秒）
# SOURCE_DETAIL_STATEMENT_TIMEOUT_MS：控制 /api/source_detail 语句超时（毫秒，防止长时间查询）
SOURCE_DETAIL_STATEMENT_TIMEOUT_MS=60000

# ===== 数据库扫描配置（可选） =====
# ALIAS_TABLE_LIMIT：别名表查询限制（防止过多表查询影响性能）
ALIAS_TABLE_LIMIT=200
# SCAN_MAX_TABLES：扫描最大表数量（限制跨表扫描范围）
SCAN_MAX_TABLES=200
# SCAN_LIMIT_PER_TABLE：每表扫描行数限制（防止单表扫描过多数据）
SCAN_LIMIT_PER_TABLE=8
# SCAN_STATEMENT_TIMEOUT_MS：扫描语句超时（毫秒，单个查询语句的超时时间）
SCAN_STATEMENT_TIMEOUT_MS=5000
# SCAN_TOTAL_TIME_BUDGET_MS：扫描总时间预算（毫秒，整个扫描过程的总超时时间）
SCAN_TOTAL_TIME_BUDGET_MS=8000

# ===== 爬虫/外部请求（可选） =====
# CRAWLER_TIMEOUT：爬虫请求默认超时时间（秒，用于验证接口的外部请求）
CRAWLER_TIMEOUT=8
# REQUEST_TIMEOUT：兼容项，等价于 CRAWLER_TIMEOUT
REQUEST_TIMEOUT=8
# CRAWLER_RETRIES：失败重试次数（网络请求失败时的重试次数）
CRAWLER_RETRIES=3
# CRAWLER_BACKOFF：重试退避系数（指数退避，控制重试间隔增长速度）
CRAWLER_BACKOFF=0.5
# 代理可选：若设置将通过代理访问外部接口
# HTTP_PROXY：HTTP 代理地址（如 http://user:pass@host:port）
HTTP_PROXY=
# HTTPS_PROXY：HTTPS 代理地址（如 https://user:pass@host:port）
HTTPS_PROXY=
# CRAWLER_HTTP_PROXY：爬虫模块专用 HTTP 代理（优先级高于 HTTP_PROXY）
CRAWLER_HTTP_PROXY=
# CRAWLER_HTTPS_PROXY：爬虫模块专用 HTTPS 代理（优先级高于 HTTPS_PROXY）
CRAWLER_HTTPS_PROXY=