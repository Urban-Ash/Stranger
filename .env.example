# ===== 基础服务配置 =====
# APP_NAME：应用显示名称（用于页面展示与日志）
APP_NAME=Stranger Database Query System
# APP_VERSION：应用版本号（用于页脚与接口返回）
APP_VERSION=2.0.0

AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Flask 基本参数
# FLASK_APP：WSGI 入口（生产部署 gunicorn 使用）
FLASK_APP=app.app:app
# FLASK_ENV：运行环境（development/production/testing）
FLASK_ENV=development
# FLASK_HOST：服务监听地址
FLASK_HOST=0.0.0.0
# FLASK_PORT：服务监听端口
FLASK_PORT=5082
# FLASK_DEBUG：是否开启调试模式（生产禁用）
FLASK_DEBUG=False

# 安全与跨域
# SECRET_KEY：会话/CSRF 加密密钥（生产必须更改）
SECRET_KEY=change-me-in-production
# CSRF_ENABLED：是否启用 CSRF 保护
CSRF_ENABLED=True
# CORS_ORIGINS：允许的跨域来源，逗号分隔或 * 表示全部
CORS_ORIGINS=*

# ===== 日志与限速 =====
# LOG_LEVEL：日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
# LOG_FILE：日志文件路径
LOG_FILE=app.log
# LOG_FORMAT：日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(funcName)s:%(lineno)d - %(message)s

# 全局速率限制
# RATE_LIMIT：全局速率限制规则（如 60 per minute）
RATE_LIMIT=60 per minute
# 兼容项（可选）：
# API_RATE_LIMIT：兼容项，映射为 RATE_LIMIT（可留空或与 RATE_LIMIT 相同）
API_RATE_LIMIT=100 per hour

# ===== 结果与缓存 =====
# MAX_RESULTS：单次返回的默认最大结果数
MAX_RESULTS=50
# MAX_QUERY_RESULTS：兼容项，等价于 MAX_RESULTS
MAX_QUERY_RESULTS=50
# CACHE_TIMEOUT：默认缓存过期时间（秒）
CACHE_TIMEOUT=300

# ===== 外部服务（AI，可选） =====
# DEEPSEEK_API_KEY：DeepSeek API 密钥
DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL：DeepSeek API 地址
DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL：使用的模型名称
DEEPSEEK_MODEL=deepseek-chat

# ===== 数据库（PostgreSQL） =====
# PG_HOST：PostgreSQL 主机地址
PG_HOST=localhost
# PG_PORT：PostgreSQL 端口
PG_PORT=5432
# PG_DATABASE：数据库名称
PG_DATABASE=stranger
# PG_USER：数据库用户名
PG_USER=postgres
# PG_PASSWORD：数据库密码（生产必须更改）
PG_PASSWORD=change-me

# 来源详情接口语句超时（毫秒）
# SOURCE_DETAIL_STATEMENT_TIMEOUT_MS：控制 /api/source_detail 语句超时（毫秒）
SOURCE_DETAIL_STATEMENT_TIMEOUT_MS=60000

# ===== 爬虫/外部请求（可选） =====
# CRAWLER_TIMEOUT：爬虫请求默认超时时间（秒）
CRAWLER_TIMEOUT=8
# CRAWLER_RETRIES：失败重试次数
CRAWLER_RETRIES=3
# CRAWLER_BACKOFF：重试退避系数（指数退避）
CRAWLER_BACKOFF=0.5
# 代理可选：若设置将通过代理访问外部接口
# HTTP_PROXY：HTTP 代理地址（如 http://user:pass@host:port）
HTTP_PROXY=
# HTTPS_PROXY：HTTPS 代理地址
HTTPS_PROXY=
# CRAWLER_HTTP_PROXY：爬虫模块专用 HTTP 代理（优先级高于 HTTP_PROXY）
CRAWLER_HTTP_PROXY=
# CRAWLER_HTTPS_PROXY：爬虫模块专用 HTTPS 代理（优先级高于 HTTPS_PROXY）
CRAWLER_HTTPS_PROXY=